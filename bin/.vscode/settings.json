{
    "java.project.sourcePaths": [
        "src/main/java"
    ],
    "java.project.outputPath": "target",
    "java.project.referencedLibraries": [
        "lib/sqlite-jdbc.jar",
        "lib/slf4j-api.jar",
        "lib/slf4j-simple.jar"
    ],
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-17",
            "path": "${env:JAVA_HOME}",
            "default": true
        }
    ],
    "files.encoding": "utf8",
    "java.compile.nullAnalysis.mode": "automatic",
    "[java]": {
        "files.encoding": "utf8"
    }
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译项目",
            "type": "shell",
            "command": "javac",
            "args": [
                "-encoding", "UTF-8",
                "-cp", "lib/sqlite-jdbc.jar;lib/slf4j-api.jar;lib/slf4j-simple.jar",
                "-d", "target",
                "${workspaceFolder}/src/main/java/com/campus/*.java",
                "${workspaceFolder}/src/main/java/com/campus/api/*.java",
                "${workspaceFolder}/src/main/java/com/campus/config/*.java",
                "${workspaceFolder}/src/main/java/com/campus/control/*.java",
                "${workspaceFolder}/src/main/java/com/campus/dao/*.java",
                "${workspaceFolder}/src/main/java/com/campus/dataobject/*.java",
                "${workspaceFolder}/src/main/java/com/campus/interceptor/*.java",
                "${workspaceFolder}/src/main/java/com/campus/model/*.java",
                "${workspaceFolder}/src/main/java/com/campus/service/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        }
    ]
}
